APP_NAME=knowra
APP_ENV=local
DEBUG=true
# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO in debug mode, WARNING in production
LOG_LEVEL=INFO
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://knowra:knowra@localhost:5432/knowra
UPLOAD_STORAGE_DIR=storage/uploads
MAX_UPLOAD_BYTES=52428800

# Upload allow-list — independent of the parse allow-list below.
# To support PPTX uploads, add application/vnd.openxmlformats-officedocument.presentationml.presentation here as well.
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,text/markdown,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation
DOCUMENT_PARSE_ENABLED=true
DOCUMENT_PARSE_ARTIFACT_DIR=storage/parsed
DOCUMENT_PARSE_MAX_BYTES=52428800
DOCUMENT_PARSE_MAX_PAGES=100
DOCUMENT_PARSE_OCR_ENABLED=false
# Legacy parser cache setting. Document model bootstrap does not read or fall
# back to DOCUMENT_PARSE_* variables; use DOCUMENT_MODEL_* below for model files.
DOCUMENT_PARSE_DOCLING_CACHE_DIR=storage/docling-cache
# Dispatcher type: only "background_tasks" is supported in this version.
DOCUMENT_PARSE_DISPATCHER=background_tasks
# Parse allow-list — independent of the upload allow-list above.
# A file must pass both lists to be parsed: it must be accepted by upload AND by parse.
DOCUMENT_PARSE_ALLOWED_CONTENT_TYPES=application/pdf,text/markdown,text/plain,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.wordprocessingml.document
DOCUMENT_PARSE_ALLOWED_EXTENSIONS=.docx,.md,.pdf,.pptx,.txt

# Document model bootstrap. These variables are isolated from DOCUMENT_PARSE_*
# and DOCUMENT_CHUNK_*; startup checks/downloads use only DOCUMENT_MODEL_*.
# After required files are ready, the app starts a non-blocking background
# preload that loads Docling/tokenizer objects into process memory. While this
# runtime preload is "loading", model-dependent parse/chunk requests fail fast.
DOCUMENT_MODEL_BOOTSTRAP_ENABLED=true
# Strategy: "download_missing" downloads missing startup models; "check_only" only validates local files.
DOCUMENT_MODEL_BOOTSTRAP_STRATEGY=download_missing
# Failure policy: "degraded" starts with unavailable readiness; "fail_fast" aborts startup.
DOCUMENT_MODEL_BOOTSTRAP_FAILURE_POLICY=degraded
DOCUMENT_MODEL_DOCLING_ARTIFACT_DIR=storage/document-models/docling
# Optional Hugging Face endpoint mirror, for example https://hf-mirror.com. Empty uses the default endpoint.
DOCUMENT_MODEL_HF_ENDPOINT=
DOCUMENT_MODEL_DOCLING_REQUIRED_MODELS=layout,tableformer
DOCUMENT_MODEL_TOKENIZER_NAME=Qwen/Qwen2-7B
DOCUMENT_MODEL_TOKENIZER_CACHE_DIR=storage/document-models/tokenizers
# Graceful shutdown waits this many seconds for model preload to stop before continuing cleanup.
DOCUMENT_MODEL_SHUTDOWN_TIMEOUT_SECONDS=5.0

# Chunking runs after successful parsing and uses the same in-memory Docling document.
# HybridChunker uses the startup-prepared tokenizer declared by DOCUMENT_MODEL_TOKENIZER_NAME.
# DOCUMENT_CHUNK_* controls chunking behavior, not model bootstrap scope or cache directories.
DOCUMENT_CHUNKING_ENABLED=true
DOCUMENT_CHUNK_MAX_TOKENS=512
DOCUMENT_CHUNK_TOKENIZER_MODEL=Qwen/Qwen2-7B
DOCUMENT_CHUNK_MERGE_PEERS=true
DOCUMENT_CHUNK_REPEAT_TABLE_HEADER=true
DOCUMENT_CHUNK_INLINE_TEXT_MAX_BYTES=2048
# Long chunk text artifacts are written here when text exceeds the inline threshold.
DOCUMENT_CHUNK_ARTIFACT_STORAGE_DIR=storage/chunks

# --- 文档向量化配置 ---
# 云端 embedding API（OpenAI 兼容接口），在分块成功后自动将 chunk 文本转化为稠密向量。
# 向量以 JSON 浮点数组存储，暂不写入 pgvector 索引列，不实现语义检索。
DOCUMENT_EMBEDDING_ENABLED=true
DOCUMENT_EMBEDDING_API_BASE_URL=https://router.tumuer.me/v1
# 敏感配置：请替换为您的实际 API Key，切勿提交真实密钥到版本控制
DOCUMENT_EMBEDDING_API_KEY=your_api_key_here
DOCUMENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
DOCUMENT_EMBEDDING_DIMENSIONS=2560
DOCUMENT_EMBEDDING_ENCODING_FORMAT=float
DOCUMENT_EMBEDDING_BATCH_SIZE=100
DOCUMENT_EMBEDDING_MAX_RETRIES=3
DOCUMENT_EMBEDDING_REQUEST_TIMEOUT=60.0

# --- 对话 LLM 配置 ---
# 云端对话 API（OpenAI 兼容接口），用于检索后的 AI 回答生成。
# 支持任何 OpenAI 兼容的中转站（如 newapi、oneapi 等）。
CHAT_API_BASE_URL=your_chat_api_base_url_here/v1
# 敏感配置：请替换为您的实际 API Key，切勿提交真实密钥到版本控制
CHAT_API_KEY=your_api_key_here
CHAT_MODEL=qwen3.5-plus
CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=1024
CHAT_REQUEST_TIMEOUT=60.0
CHAT_MAX_RETRIES=3

# 语义搜索相似度阈值（余弦距离，0-2。0=完全相同，2=完全相反）
# 仅当分块与查询的余弦距离 <= 此阈值时才纳入检索结果。
# 设为 0 可禁用相似度过滤。推荐值：0.4-0.6（取决于嵌入模型性能）
# 较低的值 = 更严格 = 更少幻觉，但可能漏掉部分相关内容
SEARCH_SIMILARITY_THRESHOLD=0.5

# 语义搜索最低分数阈值（余弦距离，0-2）
# 检索结果中最优分块（最低余弦距离）必须 <= 此阈值，否则视为"无相关结果"，
# 返回空结果且不调用 LLM。这是防止 LLM 基于弱相关内容产生幻觉的第二道防线。
# 应设置得比 SEARCH_SIMILARITY_THRESHOLD 更严格（值更小）。
# 设为 0 可禁用此检查。推荐值：比 SEARCH_SIMILARITY_THRESHOLD 低 0.1-0.15
SEARCH_MIN_SCORE_THRESHOLD=0.4

# --- 日志配置 ---
LOG_LEVEL=INFO
LOG_FORMAT=console          # console（开发，彩色可读）或 json（生产，单行 JSON）
LOG_FILE_PATH=logs/knowra.log
LOG_FILE_MAX_SIZE=10485760  # 10 MB
LOG_FILE_BACKUP_COUNT=5
